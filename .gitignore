# OMC 運用状態
.omc/

# 依存関係
node_modules/

# 環境変数・秘密情報
.env
.env.*
!.env.example

# ビルドの派生物（docs/04_要件定義.md N3）
# public/ はビルドが生成するステージング領域で、正のアセットではない。
dist/
build/
out/
public/
renders/

# 音声・動画そのものは派生物の置き場にだけ現れる想定だが、
# assets/ と characters/ の素材は正なので除外しない。
/out/**/*.mp4
/build/**/*.wav

# OS
.DS_Store
